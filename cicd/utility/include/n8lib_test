fRunTest_Compare_v1(){
	## Args
	local -r  assertMode="${1:-}"  ; shift || :  ## 'equal', 'notequal'.
	local -r  gotVal="${1:-}"      ; shift || :  ## Arg <REQUIRED>: Test val, e.g. from output of a command.
	local -r  expectVal="${1:-}"   ; shift || :
	local -r  addComment="${1:-}"  ; shift || :  ## Arg [optional]: Brief comment to include in output.

	## Variables
	local -ri prevCount_Passed=${count_Passed}
	local -ri prevCount_Failed=${count_Failed}
	local  -i doConditionalAbort=0

	((++count_Tests))

	##DEBUG
	#echo
	#echo "fRunTest_Compare_v1():"
	#echo "assertMode ...: '${assertMode}'"
	#echo "gotVal .......: '${gotVal}'"
	#echo "expectVal ....: '${expectVal}'"
	#echo "addComment ...: '${addComment}'"

	## Run the test
	fTallyResult  0  "${assertMode}"  "${gotVal}"  "${expectVal}"

	## Show output based on test results

	fEcho_Clean

	if ((count_Passed > prevCount_Passed)); then
		## Action if the test passed; includes "successful" error caught above.
		currentPassStreak=$count_Passed
		fEcho_Clean "✅ Passed: Test# ${count_Tests} [Test mode: '${assertMode}']"
	elif ((count_Failed > prevCount_Failed)); then
		## Action if the test failed
		currentPassStreak=0
		fEcho_Clean "⛔ FAILED: Test# ${count_Tests} [Test mode: '${assertMode}']"
		doConditionalAbort=1
	fi

	fEcho_Clean "Expected value .: '${expectVal}'"
	fEcho_Clean "Actual value ...: '${gotVal}'"
#	fEcho_Clean

	if ((ABORT_ON_FIRST_ERROR)) && ((doConditionalAbort)); then
		sleep ${SLEEP_BEFORE_STDERR}  ## Bash has no way to unbuffer always-buffered stdout, but stderr is always unbuffered; so stderr almost always jumps ahead of stdout. This is a crude and not-always-reliable way to USUALLY make sure they appear in order. There's no other known way to quasi-insure this, in bash.
		FECHO_NEXT_TO_STDERR=1 fEcho_Clean
		FECHO_NEXT_TO_STDERR=1 fEcho_Clean "[ ${meName_t4rge}.${FUNCNAME[0]}(): Exiting on first error as instructed."
	#	fEcho_Clean_Force
		trap - ERR
		set -e
		return ${ERRNUM_MSG_ALREADY_SHOWN}
	fi

}


## Original name alias and interface, for backwards compatibility.
## The order of arguments in fRunTest_ExecCmd_v1()
