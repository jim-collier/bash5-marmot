fRunTest(){
	## Args
	local -r  assertMode="${1:-}"  ; shift || :  ## 'equal', 'notequal', 'error', 'noerror'.  The latter two do no comparisons and accept any 'expectVal'.
	local -r  expectVal="${1:-}"   ; shift || :
	local -r  cmdStr="${1:-}"      ; shift || :
	## Pass different order of arguments than received.
	fRunTest_ExecCmd_v1 "${assertMode}"  "${cmdStr}"  "${expectVal}"
}

## New v1 name and interface.
## The order of arguments are different, but the code is the same as
##   fRunTest().
fRunTest_ExecCmd_v1(){
	## Args
	local -r  assertMode="${1:-}"  ; shift || :  ## 'equal', 'notequal', 'error', 'noerror'.  The latter two do no comparisons and accept any 'expectVal'.
	local -r  cmdStr="${1:-}"      ; shift || :
	local -r  expectVal="${1:-}"   ; shift || :

	## Variables
	local  -i errNum=0
	local     gotVal=""
	local -ri prevCount_Passed=${count_Passed}
	local -ri prevCount_Failed=${count_Failed}
	local -ri prevCount_Errors_Expected=${count_Errors_Expected}
	local -ri prevCount_Errors_Unexpected=${count_Errors_Unexpected}
	local  -i doConditionalAbort=0

	((++count_Tests))

	## Store caller's error settings
	_flib_test__Error_CallersSettings_Store

	## Run the test
	if [[ "${assertMode}" ==  'err'* ]]; then
		isExpectingError=1
		fEcho; fEcho "Test #${count_Tests} Expecting error, BEGIN ..."
		_flib_test__Error_SetHandler_DefineTrap_Ignore
			sleep ${SLEEP_BEFORE_STDERR}  ## Bash has no way to unbuffer always-buffered stdout, but stderr is always unbuffered; so stderr almost always jumps ahead of stdout. This is a crude and not-always-reliable way to USUALLY make sure they appear in order. There's no other known way to quasi-insure this, in bash.
			gotVal="$(eval "${cmdStr}"  2> >(fPipe_LogOnly >&2))" ; errNum=$? ; true  ## Send error messages to both stderr, and log
		_flib_test__Error_SetHandler_DefineTrap_Fatal
		fEcho "Test #${count_Tests} Expecting error, END."; fEcho
		isExpectingError=0
	else
		_flib_test__Error_SetHandler_DefineTrap_Fatal
		sleep ${SLEEP_BEFORE_STDERR}  ## Bash has no way to unbuffer always-buffered stdout, but stderr is always unbuffered; so stderr almost always jumps ahead of stdout. This is a crude and not-always-reliable way to USUALLY make sure they appear in order. There's no other known way to quasi-insure this, in bash.
		gotVal="$(eval "${cmdStr}"  2> >(fPipe_LogOnly >&2))" ; errNum=$? ; true  ## Send error messages to both stderr, and log
	fi
	fTallyResult  $errNum  "${assertMode}"  "${gotVal}"  "${expectVal}"

	if ((count_Errors_Expected > prevCount_Errors_Expected)); then
		## Action if the test errored as expected
		currentPassStreak=0
	fi

	## Show output based on test results

	fEcho_Clean

	if ((count_Passed > prevCount_Passed)); then
		## Action if the test passed; includes "successful" error caught above.
	#	{ ((currentPassStreak <= 0)) && fEcho_Clean; echo -n "Test #s passed: ${count_Tests}, "; } || echo -n "${count_Tests}, "; fEcho_IsInRawInlineMode_Set 1
		currentPassStreak=$count_Passed
		fEcho_Clean "✅ Passed: Test# ${count_Tests} [Test mode: '${assertMode}']"
	elif ((count_Failed > prevCount_Failed)); then
		## Action if the test failed
		currentPassStreak=0
		fEcho_Clean "⛔ FAILED: Test# ${count_Tests} [Test mode: '${assertMode}']"
		doConditionalAbort=1
	elif ((count_Errors_Unexpected > prevCount_Errors_Unexpected)); then
		## Action if the test UN-expectedly errored
		fEcho_Clean "⚠️ Errored unexpectedly: Test# ${count_Tests} [Test mode: '${assertMode}']"
		doConditionalAbort=1
	fi

	local exeName=""  exeArgs=""
	fGetIsolatedExeName  exeName  exeArgs  "${cmdStr}"
	[[ -n "${__fRunTest_EchoHook1:-}" ]] && { fEcho_Clean "${__fRunTest_EchoHook1:-}"; __fRunTest_EchoHook1=""; }
	fEcho_Clean "Test command ...: ${exeName}${exeArgs}"
	if [[ "${assertMode}" !=  *'err'* ]]; then
		fEcho_Clean "Expected value .: '${expectVal}'"
		fEcho_Clean "Actual value ...: '${gotVal}'"
	fi
	fEcho_Clean

	## Restore caller's error-handling settings
	_flib_test__Error_CallersSettings_Restore

	if ((ABORT_ON_FIRST_ERROR)) && ((doConditionalAbort)); then
		sleep ${SLEEP_BEFORE_STDERR}  ## Bash has no way to unbuffer always-buffered stdout, but stderr is always unbuffered; so stderr almost always jumps ahead of stdout. This is a crude and not-always-reliable way to USUALLY make sure they appear in order. There's no other known way to quasi-insure this, in bash.
		FECHO_NEXT_TO_STDERR=1 fEcho_Clean "[ ${meName_t4rge}.${FUNCNAME[0]}(): Exiting on first error as instructed."
	#	FECHO_NEXT_TO_STDERR=1 fEcho_Clean_Force
		return ${ERRNUM_MSG_ALREADY_SHOWN}
	fi

:;}

