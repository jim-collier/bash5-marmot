# Generic code

_flib_test__Error_CallersSettings_Store(){
	__flib_test__saved_setflags="${-}"
	__flib_test__saved_pipefail=$(shopt -po pipefail)
	__flib_test__saved_inherit_errexit=$(shopt -p inherit_errexit)
	__flib_test__saved_errtrap=$(trap -p ERR)
}
_flib_test__Error_CallersSettings_Restore(){
	[[ "${__flib_test__saved_setflags}" == *e* ]] && set -e || set +e
	[[ "${__flib_test__saved_setflags}" == *E* ]] && set -E || set +E
	eval "${__flib_test__saved_pipefail}"
	eval "${__flib_test__saved_inherit_errexit}"
	if [[ -n "${__flib_test__saved_errtrap}" ]]; then eval "${__flib_test__saved_errtrap}"; else trap - ERR; fi
}
_flib_test__Error_SetHandler_DefineTrap_Ignore(){
	set +e +E
	set +o pipefail
	trap '((++count_Errors_Expected))' ERR
}
_flib_test__Error_SetHandler_DefineTrap_Fatal(){
	set -e -E
	set -o pipefail
	trap '{ ((isExpectingError)) && ((++count_Errors_Expected)); } || ((++count_Errors_Unexpected))' ERR
}


