## Show version, copyright, about, syntax

fShowVersion(){
	((doQuietly || wasShown_Version)) && return 0
	fEcho_Clean "${THIS_FILENAME} v${THIS_VERSION} build ${THIS_BUILD}"
	wasShown_Version=1
}

fShowCopyright(){
	((doQuietly || wasShown_Copyright)) && return 0
	local copyrightStr=""
	wasShown_Version=0
	copyrightStr+="$(fShowVersion)\n"
	copyrightStr+="Copyright © ${THIS_COPYRIGHT_YEARS} ${THIS_AUTHOR}.\n"
	case "${LICENSE_SPDX,,}" in

		'agpl-3.0')
			## Strongest copyleft, most restrictive for end-users.
			## FYI: "Affero" is the name of a now nonexistent company. Main point was to close the SaaS
			##   loophole in GPLv3.
			## NOT compatible with Linux kernel code.
			copyrightStr+="Licensed under the GNU Affero General Public License 3.0. Full text at:\n"
			copyrightStr+="  https://opensource.org/license/agpl-3-0\n"
		;;

		'apache-2.0')
			## Permissive.
			## Better patent protection than BSD-2-Clause-Patent.
			## NOT compatible with Linux kernel code (due to patent clause).
			copyrightStr+="Licensed under the Apache License v2.0. Full text at:\n"
			copyrightStr+="  https://opensource.org/license/apache-2.0\n"
		;;

		'bsd-2-clause')
			## BSD and MIT are the most permissive on this list, with fewest author protections
			##   than copyleft licenses, but with widest compatibility.
			## Compatible with Linux kernel code.
			copyrightStr+="Licensed under The 2-Clause BSD License. Full text at:\n"
			copyrightStr+="  https://opensource.org/license/bsd-2-clause\n"
		;;

		'bsd-3-clause')
			## BSD and MIT are the most permissive on this list, with fewest author protections
			##   than copyleft licenses, but with widest compatibility.
			## Better patent protection than BSD-2-Clause-Patent.
			## NOT compatible with Linux kernel code (due to patent clause).
			copyrightStr+="Licensed under The 3-Clause BSD License. Full text at:\n"
			copyrightStr+="  https://opensource.org/license/BSD-3-clause\n"
		;;

		'gpl-2.0'|'gpl-2.0-only')
			## Exactly compatible with Linux kernel code (same license).
			copyrightStr+="Licensed under the GNU General Public License v2.0. Full text at:\n"
			copyrightStr+="  https://www.gnu.org/licenses/old-licenses/gpl-2.0.html\n"
		;;

		'gpl-2.0-or-later')
			## "Or-later" means the recipient can relicense the work to any higher GPL version, e.g. 3.0.
			## Compatible with Linux kernel code, unless recipient relicenses it to GPL-3.
			copyrightStr+="Licensed under the GNU General Public License v2.0 or later. Full text at:\n"
			copyrightStr+="  https://spdx.org/licenses/GPL-2.0-or-later.html\n"
		;;

		'gpl-3.0'|'gpl-3.0-only')
			## Strong copyleft.
			## NOT compatible with Linux kernel code, which is GPL-2.0-only.
			copyrightStr+="Licensed under the GNU General Public License v3.0. Full text at:\n"
			copyrightStr+="  https://opensource.org/license/GPL-3.0\n"
		;;

		'gpl-3.0-or-later')
			## Strong copyleft.
			## "Or-later" means the recipient can relicense the work to any higher future GPL version.
			## NOT compatible with Linux kernel code, which is GPL-2.0-only.
			copyrightStr+="Licensed under the GNU General Public License v3.0 or later. Full text at:\n"
			copyrightStr+="  https://spdx.org/licenses/GPL-3.0-or-later.html\n"
		;;

		'lgpl-3.0')
			## Weaker copyleft, due to allowance of dynamic linking in commercial software
			##   (which may be seen as a more flexible advantage for end-users).
			## NOT compatible with Linux kernel code.
			copyrightStr+="Licensed under the GNU Lesser General Public License v3.0\n"
			copyrightStr+="  https://opensource.org/license/lgpl-3-0\n"
		;;

		'mit')
			## BSD and MIT are the most permissive on this list, with fewest author protections
			##   than copyleft licenses, but with widest compatibility.
			## Compatible with Linux kernel code.
			copyrightStr+="Licensed under the MIT License (MIT). Full text at:\n"
			copyrightStr+="  https://mit-license.org/\n"
		;;

		'mpl-2.0')
			## Weak copyleft.
			## Compatible with Linux kernel code, if file lacks "Incompatible With Secondary Licenses" notice.
			copyrightStr+="Licensed under the Mozilla Public License 2.0\n"
			copyrightStr+="  https://opensource.org/license/MPL-2.0\n"
		;;

		*) fThrowError "Sorry, I haven't been programmed yet to display license '${LICENSE_SPDX}'." ;;
	esac
	copyrightStr+="No warranty."
	fEcho_Clean; fEcho_Clean_byref copyrightStr; fEcho_Clean
	wasShown_Copyright=1
}

fShowAbout(){
	((doQuietly || wasShown_About)) && return 0
	## Validate nameref args
	fIsNameref  "${1:-}" || return ${ERRNUM_MSG_ALREADY_SHOWN}
	## Gather args
	local -n ptr_AboutText_t5j9j=$1
	## Validate
	[[ -n "${ptr_AboutText_t5j9j}" ]] || fThrowError "No 'about' text provided."
	## Logic
	fEcho_Clean; fEcho_Clean_byref ptr_AboutText_t5j9j; fEcho_Clean
	wasShown_About=1
}

fShowSyntax(){
	((doQuietly || wasShown_Syntax)) && return 0
	## Validate nameref args
	fIsNameref  "${1:-}" || return ${ERRNUM_MSG_ALREADY_SHOWN}
	## Gather args
	local -n ptr_SyntaxText_t5j9j=$1
	## Validate
	[[ -n "${ptr_SyntaxText_t5j9j:-}" ]] || fThrowError "No 'syntax' text provided."
	fEcho_Clean; fEcho_Clean_byref ptr_SyntaxText_t5j9j; fEcho_Clean
	wasShown_Syntax=1
}


##
## User-prompt-related

fIntroPromptToContinue(){
	((doQuietly || ! doPromptToContinue)) && return 0
	local -r extraInfoString="${1:-}"
	{ fEcho_Clean; fShowCopyright; fShowAbout_Local; fEcho_Clean; }
	[[ -n "${extraInfoString}" ]] && { fEcho_Clean; fEcho_Clean "${extraInfoString}"; }
	fPromptYN "Continue? (y|n): " < /dev/tty || { fEcho "User aborted."; return ${ERRNUM_MSG_ALREADY_SHOWN}; }
}

fPromptYN(){
	((doQuietly)) && return 0
	local promptStr="${1:-}"
	[[ -z "${promptStr}" ]] && promptStr="Continue? (y|n): "
	read -r -p "${promptStr}" userAnswer < /dev/tty
	fEcho_ResetBlankCounter
	{ [[ "${userAnswer,,}" == "y" ]] && return 0; } || return ${ERRNUM_MSG_ALREADY_SHOWN}
}

fPressAnyKeyToContinue(){
	((doQuietly)) && return 0
	local promptStr="${1:-}"
	[[ -z "${promptStr}" ]] && promptStr="Press any key to continue ..."
	read -n 1 -s -p "${promptStr}" userAnswer < /dev/tty
	fEcho_Clean_Force
}


