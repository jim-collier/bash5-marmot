## Functions

fRunGui(){
	[[ -n "${1:-}" ]] || fThrowError "Nothing specified to run."
	local quotedParams=""; fBuildQuotedParams  quotedParams  "${@}"
	echo "Executing: ( (eval \"nohup ${quotedParams}  &>/dev/null\") & disown ) &>/dev/null"  ## Debug output to console. Users won't see since this is run by GUI.
	( (eval "nohup ${quotedParams}  &>/dev/null") & disown ) &>/dev/null
}

fRunSilentlyWithoutError(){ fRunGui  "${@}"; }

fRunGuiAsSudo(){
	[[ -n "${1:-}" ]] || fThrowError "Nothing specified to run."
	local quotedParams=""
	fBuildQuotedParams  quotedParams  "${@}"
	sudo true
	echo "Executing: ( (eval \"sudo  DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus XDG_RUNTIME_DIR=/run/user/0  ${quotedParams}  &>/dev/null\") & disown ) &>/dev/null"  ## Debug output to console. Users won't see since this is run by GUI.
	( (eval "sudo  DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus XDG_RUNTIME_DIR=/run/user/0  ${quotedParams}  &>/dev/null") & disown ) &>/dev/null
}




