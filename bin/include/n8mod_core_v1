## Error-handling (minified but not obfuscated)
## The default `fError_DefineBehavior_*` is `return`, not `exit`. Call `fError_DefineBehavior_Exit` to change that.
## Note that SIGKILL (e.g. from kill -9) isn't possible to trap.
if [[ ! -v __fError_WasCleanupRun ]]; then
	declare -gi  __fError_WasCleanupRun=0          ## Managed internally by this suite.
	declare -gi  __fError_doExitNotReturn=0        ## Managed internally by this suite.
	declare -gi  __fError_DoIgnore=0               ##
	declare -gi  __fError_ExitCode_Previous=0      ## To help avoid repeat reports to console.
	declare -gi  _exitCode=0                       ## Set by this suite, but readable by calling functions. Think of it as an extended '$?' that doesn't immediately clear.
	declare -gi  _global_ExitLoopNow=0             ## Only way to exit loops when fError_DefineTrap_Ignore() in force, and user presses CTRL+C.
fi
fThrowError(){
	## This will cause _fSingleExitPoint() to fire twice:
	##   - Once for sure by setting return val of ${ERRNUM_MSG_ALREADY_SHOWN}.
	##   - Again on exit.
	## _fSingleExitPoint() handles this.
	local errMsg="${1:-}"              ; [[ -n "${errMsg}" ]]                      || errMsg="An error occurred."
	local funcName=".${FUNCNAME[1]}()" ; [[ "${funcName:-}" =~ '.main()'|'.()' ]]  && funcName=''
	errMsg="Error in $(basename "${BASH_SOURCE[1]}")${funcName:-}: ${errMsg:-}"
	_exitCode=$ERRNUM_MSG_ALREADY_SHOWN
	FECHO_NEXT_TO_STDERR=1 fEcho_Clean
	sleep ${SLEEP_BEFORE_STDERR}  ## Bash has no way to unbuffer always-buffered stdout, but stderr is always unbuffered; so stderr almost always jumps ahead of stdout. This is a crude and not-always-reliable way to USUALLY make sure they appear in order. There's no other known way to quasi-insure this, in bash.
	FECHO_NEXT_TO_STDERR=1 fEcho_Clean "${errMsg}"
	_fError_ShowCallStack
	if ((! __fError_DoIgnore && __fError_doExitNotReturn)); then exit ${_exitCode}; else return ${_exitCode}; fi
}
_fError_ShowCallStack(){
	## Show call stack. This is only ever called immediately following other error messages to stderr, so no special console allowances needed.
	local callStack=""
	local funcName=""
	for (( i = 2; i < ${#FUNCNAME[@]}; i++ )); do  ## 0=this function, don't output that.
		funcName="${FUNCNAME[i]}"
		if   [[ "${funcName}" == "fThrowError" ]]; then continue
		elif [[ "${funcName}" =~ ^main|source$ ]]; then  funcName="$(basename "${BASH_SOURCE[1]}")"
		else                                           funcName+="()"; fi
		[[ -n "${callStack}" ]] && callStack+=", "
		callStack+="${funcName}"
	done;:
	echo "Call stack: ${callStack}"  >&2
}
_fSingleExitPoint(){
	## Grab from bash global (note: clunky string compares for integers can't fail)
	local -r errCommand="$BASH_COMMAND"

	## Args
	local -r signal="${1:-}"
	local -r lineNum="${2:-}"
	local    exitCode="${3:-}"

	## Checks to bail early. Use if-then-fi to avoid implicit `return 1` with bash's simpler `&&` eval.
	if [[ "${__fError_WasCleanupRun:-}" == "1" ]]; then return ${_exitCode} ; fi  ## We've already been here before.

	## Variables for logic compute
	local -i doForceEcho_AtTop=0
	local -i wasUserInterrupted=0
	local -i doShowMsg_ErrFields=0
	local -i doShowMsg_CallStack=0
	local -i doForceEcho_AtBottom=0
	local -i doRunCallerCleanup=0
	local -i doExit=0
	local -i doReturn=0
	local -i isIgnoring=0
	local -i isError=0
	local -i isUnexpectedError=0
	local -i isSubshell=$(( BASHPID != $$ ))

	## Process complex logic separately from actions
	_exitCode=$exitCode #..............: Local to global
	isIgnoring=$__fError_DoIgnore #....: Global to local
	isError=$(( exitCode != 0 ))
	[[ ! "${exitCode}" =~ ^('0'|"${ERRNUM_MSG_ALREADY_SHOWN}")$ ]]                        && isUnexpectedError=1
	((  isUnexpectedError )) && [[ "${signal}" == "SIGINT" ]]                             && wasUserInterrupted=1
	((  wasUserInterrupted))                                                              && doForceEcho_AtTop=1
	(( !isIgnoring && isUnexpectedError ))                                                && doForceEcho_AtTop=1
	(( !isIgnoring && isUnexpectedError ))                                                && doShowMsg_CallStack=1
	(( !isIgnoring && isUnexpectedError )) && [[ "${signal}" != "SIGINT" ]]               && doShowMsg_ErrFields=1
	((  isIgnoring )) && [[ "${signal}" != "EXIT" ]]                                      && doForceEcho_AtBottom=1
	((  doShowMsg_ErrFields ))                                                            && doForceEcho_AtBottom=1
	((  doShowMsg_CallStack ))                                                            && doForceEcho_AtBottom=1
	(( !isSubshell )) && { (( !isIgnoring )) || [[ "${signal}" == "EXIT" ]]; }            && doRunCallerCleanup=1
	(( !isIgnoring )) || [[ "${signal}" == "EXIT" ]] && ((   __fError_doExitNotReturn ))  && doExit=1
	(( !isIgnoring )) || [[ "${signal}" == "EXIT" ]] && (( ! __fError_doExitNotReturn ))  && doReturn=1

	## Take actions based on flags
	if ((doForceEcho_AtTop)); then
		sleep ${SLEEP_BEFORE_STDERR}  ## Bash has no way to unbuffer always-buffered stdout, but stderr is always unbuffered; so stderr almost always jumps ahead of stdout. This is a crude and not-always-reliable way to USUALLY make sure they appear in order. There's no other known way to quasi-insure this, in bash.
		FECHO_NEXT_TO_STDERR=1 fEcho_Clean_Force
	fi
	if ((wasUserInterrupted)); then
		_global_ExitLoopNow=1
		if ((isIgnoring)); then echo "[ User break. ]"  >&2
		else                    echo "User break."      >&2; fi
	fi
	if ((doShowMsg_ErrFields)); then
		echo -e "Signal ...: ${signal}"      >&2
		echo -e "Exit code : ${exitCode}"    >&2
		echo -e "At line ..: ${lineNum}"     >&2
		echo -e "Command ..: ${errCommand}"  >&2
	fi
	((doShowMsg_CallStack)) && _fError_ShowCallStack
	if ((doForceEcho_AtBottom)); then
		FECHO_NEXT_TO_STDERR=1 fEcho_Clean_Force
	#	[[ "${__fError_JustDidEmptyForceEcho:-}" != "1" ]] && FECHO_NEXT_TO_STDERR=1 fEcho_Clean_Force
	#	__fError_JustDidEmptyForceEcho=1
	fi
	__fError_ExitCode_Previous=${_exitCode}
	if ((doRunCallerCleanup)); then
		## Run caller cleanup function (exactly once for every exit condition clean or error - except untrappable kill -9).
		__fError_WasCleanupRun=1
		fCleanup  ## User cleanup; always fire once on final exit, to allow caller to cleanup logfiles etc.
	fi

	## Revisit variable values
	((isSubshell && isUnexpectedError)) && exitCode=$ERRNUM_MSG_ALREADY_SHOWN
	((doExit || doReturn))              && __fError_WasCleanupRun=1
	((isIgnoring)) && { true; exitCode=0; }

	## Take final actions
	((doExit))                          && exit ${exitCode}
	((doReturn))                        && return ${exitCode}
}
fError_DefineTrap_Fatal(){       :; _exitCode=0 ; __fError_ExitCode_Previous=0; __fError_DoIgnore=0      ; set -e; }  ## Standard `set -e` behavior.
fError_DefineTrap_Ignore(){      :; _exitCode=0 ; __fError_ExitCode_Previous=0; __fError_DoIgnore=1      ; set +e; }  ## Eats errors and returns true.
fError_DefineBehavior_Return(){  :; _exitCode=0 ; __fError_ExitCode_Previous=0; __fError_doExitNotReturn=0         ; } ## Returns error on error.
fError_DefineBehavior_Exit(){    :; _exitCode=0 ; __fError_ExitCode_Previous=0; __fError_doExitNotReturn=1         ; } ## Exits script on error.
## Traps defs. Notes:
##   - Redundant with EXIT: SIGHUP (129), SIGTERM (143), SIGPIPE.
##   - Don't trap: SIGALRM, SIGUSR1, SIGUSR2.
trap '_fSingleExitPoint ERR      ${LINENO} $?' ERR       ## Fires on any non-zero exit with `set -e`.
trap '_fSingleExitPoint EXIT     ${LINENO} $?' EXIT      ## Always fires on exit, even if already handled an error.
trap '_fSingleExitPoint SIGINT   ${LINENO} $?' SIGINT    ## CTRL+C
trap '_fSingleExitPoint SIGQUIT  ${LINENO} $?' SIGQUIT   ## CTRL+\, dumps core if not trapped.
fError_DefineTrap_Fatal
fError_DefineBehavior_Return

