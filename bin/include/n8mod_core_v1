## Username and home
fGetOgUserName(){
	## Validate nameref args:
	[[ -v 1 ]] || fThrowError "Calling function must pass a nameref to receive this function's output, as arg1."
	## Gather args
	local -n ptr_Output_s74rg=$1  ## ; shift || :  ## Arg <REQUIRED>: Nameref for return value.
	## Init
	local retVal=""
	ptr_Output_s74rg=""
	## Logic
	retVal="${USER}"                         ; { [[ -n "${retVal}" ]] && [[ "${retVal,,}" != "root" ]]; } && { ptr_Output_s74rg="${retVal}"; return 0; }
	retVal="${SUDO_USER}"                    ; { [[ -n "${retVal}" ]] && [[ "${retVal,,}" != "root" ]]; } && { ptr_Output_s74rg="${retVal}"; return 0; }
	retVal="$(whoami  2>/dev/null || true)"  ; { [[ -n "${retVal}" ]] && [[ "${retVal,,}" != "root" ]]; } && { ptr_Output_s74rg="${retVal}"; return 0; }
	retVal="$(logname 2>/dev/null || true)"  ; { [[ -n "${retVal}" ]] && [[ "${retVal,,}" != "root" ]]; } && { ptr_Output_s74rg="${retVal}"; return 0; }
	retVal="${USER}"                         ; { [[ -n "${retVal}" ]] && [[ "${retVal,,}" != "root" ]]; } && { ptr_Output_s74rg="${retVal}"; return 0; }
	retVal="${USER}"                         ;   [[ -n "${retVal}" ]]                                     && { ptr_Output_s74rg="${retVal}"; return 0; }
	retVal="$(whoami  2>/dev/null || true)"  ;   [[ -n "${retVal}" ]]                                     && { ptr_Output_s74rg="${retVal}"; return 0; }
	[[ -z "${retVal}" ]] && fThrowError  "Could not figure out username. This could be a bug [¢Яēᛏ]."  "${FUNCNAME[0]}"
}
fGetOgUserHome(){
	## Validate nameref args:
	[[ -v 1 ]] || fThrowError "Calling function must pass a nameref to receive this function's output, as arg1."
	## Gather args
	local -n ptr_Output_s74rm=$1      ; shift || : ## Arg <REQUIRED>: Variable reference for result.
	local    userName_s74rm="${2:-}"  ; shift || : ## Arg [optional]: Username. If blank will use fGetOguserName().
	## Init
	local    retVal=""
	ptr_Output_s74rm=""
	## Logic
	retVal="${HOME}"                                                                                       ; { [[ -n "${retVal}" ]] && [[ "${retVal,,}" != "/root" ]] && [[ -d "${retVal}" ]]; } && { ptr_Output_s74rm="${retVal}"; return 0; }
	[[ -z "${userName_s74rm}" ]] && fGetOgUserName userName_s74rm
	retVal="$(getent passwd "${userName_s74rm}" | cut -d: -f6)"                                            ; { [[ -n "${retVal}" ]] && [[ "${retVal,,}" != "/root" ]] && [[ -d "${retVal}" ]]; } && { ptr_Output_s74rm="${retVal}"; return 0; }
	retVal="$(getent passwd "${userName_s74rm:-${SUDO_USER:-${USER}}}" | cut -d: -f6 2>/dev/null || true)" ; { [[ -n "${retVal}" ]] && [[ "${retVal,,}" != "/root" ]] && [[ -d "${retVal}" ]]; } && { ptr_Output_s74rm="${retVal}"; return 0; }
	retVal="/home/${userName_s74rm}"                                                                       ; { [[ -n "${retVal}" ]] && [[ "${retVal,,}" != "/root" ]] && [[ -d "${retVal}" ]]; } && { ptr_Output_s74rm="${retVal}"; return 0; }
	retVal="${HOME}"                                                                                       ; { [[ -n "${retVal}" ]] && [[ -d "${retVal}" ]]; }                                   && { ptr_Output_s74rm="${retVal}"; return 0; }
	[[   -z "${retVal}" ]] && fThrowError  "Could not figure out user's home directory. This could be a bug [¢Яēᛏ]."
	[[ ! -d "${retVal}" ]] && fThrowError  "Calculated home directory doesn't exist: '${retVal}'. This could be a bug [£⍤ㅍᛦ]."
}

