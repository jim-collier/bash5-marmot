## Execution control. Parent script should invoke this when ready to begin.
fInit(){
	if [[ -n "${RELAUNCH_SENTINELVAL:-}"  &&  "${1:-}" == "${RELAUNCH_SENTINELVAL:-}" ]]; then
		## Reentrant (e.g. relaunched as sudo): invoke the function specified.
		## Doesn't have to be reentrant, caller could use this to start something other than fMain().
		## In this form, args:
		##	Arg1: Literally "${RELAUNCH_SENTINELVAL}"
		##	Arg2: Function name in calling parent script to launch with remaining arguments.

		[[ -n "${2:-}" ]]               || { echo -e "\nError in ${THIS_LIB_FILE_NAME_t5hpa}: A valid 'relaunch' sentinel value was passed as arg1, but no function name to branch to was passed as arg2.\n" ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }
		declare -f "${2:-}" &>/dev/null || { echo -e "\nError in ${THIS_LIB_FILE_NAME_t5hpa}: The function name passed as arg2 isn't defined in this environment: '${2:-}'.\n"                               ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }
		${2:-} "${@:3}"

	else
		## The first and possibly/usually only entry point. Args are whatever the script needs.
		## fMain() must exist in calling parent script.

		declare -f "fMain" &>/dev/null || { echo -e "\nError in ${THIS_LIB_FILE_NAME_t5hpa}: The function fMain() isn't defined in this environment: '${2:-}'.\n" ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }
		fMain  "${@}"

	fi
}


