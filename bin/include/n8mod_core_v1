## Echo-related (minified but not obfuscated)
## Purpose:
##   - Lets callers not worry about the often careful planning and/or extra
##     logic required just to avoid repeating empty lines in stdout output to
##     users. Many programmers wind up adding basic logic like this anyway.
##     Also, regular fEcho() outputs a formatted version like this:
##     "[ OUTPUT ]".
## Notes:
##   - Call fEcho_ResetBlankCounter(), after stdout that you don't control
##     (e.g. from external programs), and its last line is non-blank.
##   - There's room for non-trivial performance improvement here, by removing
##     the extra indirections done for code efficiency. That would basically
##     mean doing what real compilers do as part of optimization, and duplicate
##     the code for each function that uses it. This could improve performance
##     in long-running loops significantly. (Alternately, don't use these
##     functions frequently in tight long-running loops, that aren't dominated
##     by other much longer-running lines of code.)
## OK if redundant with same definitions in global scope loaded at script start.
if [[ ! -v FECHO_NEXT_TO_STDERR ]]; then
	declare -gi FECHO_NEXT_TO_STDERR=0    ## Only the next fEcho*() will go to stderr.
	declare -gi _wasLastEchoBlank=0
	declare -gi _isEchoInRawInlineMode=0
fi
fEcho_Clean_byref(){
	[[ -v 1  ]] || fThrowError "Calling function must pass a nameref to supply the input value to this function, as arg1 (string to echo)."
	local -n ptr_ToEcho_t5jf2=$1
	local -i doEcho=0
	## End 'InRawInlineMode'; Duplicate functionality of `fEcho_IsInRawInlineMode_Set 0`; only to stdout.
	if ((_isEchoInRawInlineMode)); then echo; _isEchoInRawInlineMode=0; _wasLastEchoBlank=0; fi
	## Logic
	if   [[ -n "${ptr_ToEcho_t5jf2}" ]] ; then doEcho=1 ; _wasLastEchoBlank=0
	elif ((! _wasLastEchoBlank))        ; then doEcho=1 ; _wasLastEchoBlank=1 ; fi
	## Do
	if ((doEcho)); then
		if ((FECHO_NEXT_TO_STDERR)); then echo -e "${ptr_ToEcho_t5jf2}" >&2 ; FECHO_NEXT_TO_STDERR=0
		else                              echo -e "${ptr_ToEcho_t5jf2}"                              ; fi
	fi; }
fEcho_ResetBlankCounter()     { _wasLastEchoBlank=0;      }
fEcho_WasLastEchoBlank_Set()  { { [[ "${1:-}" == "1" ]] && _wasLastEchoBlank=1; } || _wasLastEchoBlank=0;  }
fEcho_WasLastEchoBlank_Get()  { { ((_wasLastEchoBlank > 0)) && return 0; } || return ${ERRNUM_MSG_ALREADY_SHOWN}; }
fEcho_IsInRawInlineMode_Set() { { [[ "${1:-}" == "1" ]] && _isEchoInRawInlineMode=1; } || if ((_isEchoInRawInlineMode)); then echo; _isEchoInRawInlineMode=0; _wasLastEchoBlank=0; fi; }  ## Script it telling fEcho* that something is going to be echoing to the screen in non-linefeed mode without its knowledge. (E.g. "echo -n 'something: '".)
fEcho_IsInRawInlineMode_Get() { { ((_isEchoInRawInlineMode)) && return 0; } || return ${ERRNUM_MSG_ALREADY_SHOWN}; }
