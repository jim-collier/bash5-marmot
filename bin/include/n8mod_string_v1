fBgrep() {
	##	Purpose:
	##		- Pure bash `grep -E` replacement using ERE via [[ =~ ]].
	##	NOTE:
	##		- This does not allow data to be piped in from stdin, unlike `grep`,
	##		  because:
	##		    1. If you used pipes, you'd create a subshell, and obviate the
	##		       advantage of using this (avoiding that performance hit). If
	##		       you need to use a pipe, you might as well use `grep`.
	##		    2. Then this function couldn't use namerefs, which is another
	##		       speedup tactic when working with large strings.
	##	Features:
	##		- Supports: groups (), alternation '|', character classes [abc],
	##		  negated [^x], POSIX classes [[:alpha:]], anchors ^ $,
	##		  wildcard ., quantifiers * + ? {n,m}.
	##		- Does NOT support: PCRE (e.g. `grep -P`). No lookahead/behind,
	##		  no \d \w \s (use [0-9] [[:alnum:]] [[:space:]]). Also -o only
	##		  returns the first match, like `grep -o 'a' <<< "abba" | head -n 1`.
	##		- Requires bash 4.3+ (namerefs), ERE support via system regex engine.
	##	Usage: fBgrep  <RetVar>  <Flags: -iov|-->  <RegEx>  <InVar>
	##		RetVar    REQUIRED nameref: Receives result as single newline-joined string.
	##		Flags     REQUIRED single string (can be '' or '--' for no flags):
	##		  -i        Case-insensitive (uses nocasematch, restored after).
	##		  -o        Output only matched portion (BASH_REMATCH[0])
	##		              Limited to first match per line only; which is the most common
	##		              use-case anyway e.g. `grep -o | head -n 1`.
	##		  -v        Invert match (inherently incompatible with -o).
	##		RegEx     REQUIRED string: ERE pattern string.
	##		InVar     REQUIRED namref: Input variable, that contains the main
	##                  string to match against. (In `grep` this is usually piped in.)
	##	Examples:
	##		fBgrep resultVar  -i   'foo|bar'   inputVar
	##		fBgrep resultVar  -io  'foo|bar'   inputVar
	##		fBgrep resultVar  -iv  'foo'       inputVar
	##		fBgrep resultVar  -o   '[0-9]+'    inputVar
	##		fBgrep resultVar  --   '^[0-9]+$'  inputVar  ## No flags
	##		fBgrep resultVar  ''   '^[0-9]+$'  inputVar  ## No flags
	##	History:
	##		- 20260523 JC: Finished version with:
	##			- Optional RetVar (if also pass -q).
	##			- Optional flags.
	##			- Requires a loop for arg processing.
	##		- 20260524 JC: Arg processing is too complex for a function that
	##			           must be light and ultra-fast, so:
	##			- Removed -q as an option (separate function instead).
	##			- Made all args required ('--' if no options).

	## Validate nameref args [use raw comparison instead of fIsNameref() for hotpath].
	nref="${1:-}"; { [[ -n "${nref}" ]] && [[ ${nref} =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && declare -p "${nref}" &>/dev/null; }  || { fThrowError "Invalid nameref argument '${nref}'. Are one or more arguments missing?" ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }
	nref="${4:-}"; { [[ -n "${nref}" ]] && [[ ${nref} =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && declare -p "${nref}" &>/dev/null; }  || { fThrowError "Invalid nameref argument '${nref}'. Are one or more arguments missing?" ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }

	## Gather args
	local -n ptr_Output_t5qdb=$1 ; shift || :
	local -r arg_Flags="${1:-}"  ; shift || :
	local -r regEx="${1:-}"      ; shift || :
	local -n ptr_Input_t5qdb=$1  ; shift || :

	## Parse flags
	local  doInvertMatch=0  doIgnoreCase=0  doOnly=0
	[[ ${arg_Flags} == *v* ]] && doInvertMatch=1
	[[ ${arg_Flags} == *i* ]] && doIgnoreCase=1
	[[ ${arg_Flags} == *o* ]] && doOnly=1
	readonly  doInvertMatch  doIgnoreCase  doOnly

	## Validate
	((doOnly  &&  doInvertMatch))                             &&  { fThrowError 'Flags -o and -v togother, are incompatible.'                                                                                                                                                            ; return $ERRNUM_MSG_ALREADY_SHOWN; }

	## Init
	ptr_Output_t5qdb=""  ## Empty return is the default.

	## Check opptys for early exit, without having to run regex. (All non-error return values are 0 in this function. See fBgrepQ for an return value version.)
	if [[ -z "${ptr_Input_t5qdb}" ]]; then
		## Grep with empty input always returns empty, and exit 1 - no matter the flags or regex.
		return
	elif [[ -z "${regEx}" ]]; then
		if ((doInvertMatch)); then
			## `grep -E` with empty regex AND `-v` always returns empty, and exit 1.
			return
		elif ((doOnly)); then
			## `grep -E` with empty regex AND `-o` always returns empty, and exit 0.
			return
		else
			## Otherwise, `grep -E` with empty regex (with non-empty input and no flags) returns original input, and exit 0.
			ptr_Output_t5qdb="${ptr_Input_t5qdb}"
			return
		fi
	fi

	# save and set nocasematch if -i
	local -i doRestore_Set_nocasematch=0
	if (( doIgnoreCase )); then
		shopt -q nocasematch && doRestore_Set_nocasematch=1 || doRestore_Set_nocasematch=0
		shopt -s nocasematch
	fi

	local    nextLine=""
	local -i didMatch=0
	local    retValStr=""
	while IFS= read -r nextLine; do
		if [[ $nextLine =~ $regEx ]]; then didMatch=1; else didMatch=0; fi
		if (( doInvertMatch ? !didMatch : didMatch )); then
			if ((doOnly)); then  retValStr+="${BASH_REMATCH[0]}"$'\n'
			else                 retValStr+="${nextLine}"$'\n'
			fi
		fi
	done <<< "${ptr_Input_t5qdb}";:

	## Restore nocasematch to original state.
	(( doIgnoreCase ))  &&  { if (( doRestore_Set_nocasematch )); then shopt -s nocasematch; else shopt -u nocasematch; fi; } ;:

	## Set output
	ptr_Output_t5qdb="${retValStr%$'\n'}"  ## Trim trailing newline

}

fBgrepQ() {
	##	Purpose:
	##		- Pure bash `grep -Eq` replacement using ERE via [[ =~ ]].
	##		- Rather than returning a string, the function returns 0 (match)
	##		  or 1 (not match).
	##		- Mostly a wrapper for fBgrep, so it doesn't have to hassle with
	##		  handling '-q', as fBgrep_WithQ_DEPREC(), which was expensive
	##		  with an arg parsing array and more oppty for bugs.
	##	NOTE:
	##		- See fBgrep() for flags and arguments. Except...
	##		- There is no 'output' namevar argument.
	##	History:
	##		- 20260524 JC: Created.

	## Validate nameref args [use raw comparison instead of fIsNameref() for hotpath].
	nref="${3:-}"; { [[ -n "${nref}" ]] && [[ ${nref} =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && declare -p "${nref}" &>/dev/null; }  || { fThrowError "Invalid nameref argument '${nref}'. Are one or more arguments missing?" ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }

	## Gather args
	local -r arg_Flags="${1:-}"  ; shift || :
	local -r regEx="${1:-}"      ; shift || :
	local -n ptr_Input_t5rrs=$1  ; shift || :

	## Check opptys for early exit, without having to run fBgrep.
	if [[ -z "${ptr_Input_t5rrs}" ]]; then
		## Grep with empty input always returns empty, and exit 1 - no matter the flags or regex.
		return 1
	elif [[ -z "${regEx}" ]]; then
		if [[ "${arg_Flags}" == *v* ]]; then
			## `grep -E` with empty regex AND `-v` always returns empty, and exit 1.
			return 1
		elif [[ "${arg_Flags}" == *o* ]]; then
			## `grep -E` with empty regex AND `-o` always returns empty, and exit 0.
			return 0
		else
			## Otherwise, `grep -E` with empty regex (with non-empty input and no flags) returns original input, and exit 0.
			return 0
		fi
	fi

	## Variables
	local bgrep_Output=""

	## Call fBgrep()
	fBgrep  bgrep_Output  "${arg_Flags}"  "${regEx}"  ptr_Input_t5rrs

	## If anything was returned, even with `-o` or `-v`, that's a sucess.
	if [[ -n "${bgrep_Output}" ]]; then return 0; else return 1; fi

}

fBhead() {
	##	Purpose:
	##		- Pure bash partial implementation of GNU `head`.
	##	Notes:
	##		- Only deals with variables for input, not files. For files,
	##		  regular GNU `head` would be better than any bash implementation anyway.

	## Validate nameref args [use raw comparison instead of fIsNameref() for hotpath].
	(( $# >= 2 )) || { fThrowError "Need at least output and input namerefs." ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }
	nref="${1:-}" ; { [[ -n "${nref}" ]] && [[ ${nref} =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && declare -p "${nref}" &>/dev/null; }  || { fThrowError "Invalid nameref argument '${nref}'. Are one or more arguments missing?" ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }
	nref="${!#}"  ; { [[ -n "${nref}" ]] && [[ ${nref} =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && declare -p "${nref}" &>/dev/null; }  || { fThrowError "Invalid nameref argument '${nref}'. Are one or more arguments missing?" ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }

	## Gather args
	local -n ptr_Output_t5rth=$1
	local -n ptr_Input_t5rth=${!#}

	## Default return
	ptr_Output_t5rth=""

	## Process middle args
	local -i getNumLines=10
	set -- "${@:2:$#-2}"  ## Strip off first and last arg
	while (( $# )); do
		case "${1}" in
			'-n')  getNumLines=$2      ; shift 2 ;;
			'-n'*) getNumLines=${1#-n} ; shift   ;;
			*)                           shift   ;;
		esac
	done

	## Bail early if possible
	[[ -n "${ptr_Input_t5rth}" ]] || return 0

	## Convert escaped newline characters into real newlines
	#printf -v ptr_Input_t5rth '%b' "${ptr_Input_t5rth}"
	ptr_Input_t5rth=${ptr_Input_t5rth//\\n/$'\n'}

	## Put lines into an array, then get the top values from that array
	local -a linesArr
	mapfile -t -n ${getNumLines} linesArr <<< "${ptr_Input_t5rth}"
	(( ${#linesArr[@]} > 0)) || return 0  ## Bail if array is empty
	printf -v ptr_Output_t5rth '%s\n' "${linesArr[@]}"

}


fGetStrMatchPos(){
	##	Purpose: Returns 1-based index of position of first match. 0= no match.
	##	Notes: Uses namerefs in so that any of the strings can be huge, with less performance hit.
	## Validate nameref args [use raw comparison instead of fIsNameref() for hotpath].
	nref="${1:-}"; { [[ -n "${nref}" ]] && [[ ${nref} =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && declare -p "${nref}" &>/dev/null; }  || { fThrowError "Invalid nameref argument '${nref}'. Are one or more arguments missing?" ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }
	nref="${2:-}"; { [[ -n "${nref}" ]] && [[ ${nref} =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && declare -p "${nref}" &>/dev/null; }  || { fThrowError "Invalid nameref argument '${nref}'. Are one or more arguments missing?" ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }
	## Gather args
	local -n ptr_Output_s74ht=$1         ; shift || :  ## Arg <REQUIRED>: Nameref: Int return value, 0=no match, >=1 position of start of firt match.
	local -n ptr_SuperString_s74ht=$1    ; shift || :  ## Arg <REQUIRED>: Nameref: String: Main string to search in.
	local    findSubString="${1:-}"      ; shift || :  ## Arg <REQUIRED>: Nameref: String: String to find.
	## Init
	ptr_Output_s74ht=0
	## Logic
	{ [[ -z "${ptr_SuperString_s74ht}" ]] || [[ -z "${findSubString}" ]]; } && return 0
	local -r testStr="${ptr_SuperString_s74ht%%"$findSubString"*}"
	[[ "${testStr}" != "${ptr_SuperString_s74ht}" ]] && ptr_Output_s74ht=$((${#testStr}+1))
:;}

fSplitStr (){
	##	Purpose: Split a string into left and right parts, on first occurrence of a given delimiter and specified scan direction.
	##	Notes: Uses namerefs in so that any of the strings can be huge, with less performance hit.
	## Validate nameref args [use raw comparison instead of fIsNameref() for hotpath].
	nref="${1:-}"; { [[ -n "${nref}" ]] && [[ ${nref} =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && declare -p "${nref}" &>/dev/null; }  || { fThrowError "Invalid nameref argument '${nref}'. Are one or more arguments missing?" ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }
	nref="${2:-}"; { [[ -n "${nref}" ]] && [[ ${nref} =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && declare -p "${nref}" &>/dev/null; }  || { fThrowError "Invalid nameref argument '${nref}'. Are one or more arguments missing?" ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }
	nref="${3:-}"; { [[ -n "${nref}" ]] && [[ ${nref} =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && declare -p "${nref}" &>/dev/null; }  || { fThrowError "Invalid nameref argument '${nref}'. Are one or more arguments missing?" ; return ${ERRNUM_MSG_ALREADY_SHOWN}; }
	## Gather args
	local -n  ptr_output_LeftStr_s8hd0=$1       ; shift || :  ## Arg <REQUIRED>: Nameref: Str return value; left substring.
	local -n  ptr_output_RightStr_s8hd0=$1      ; shift || :  ## Arg <REQUIRED>: Nameref: Str return value; right substring.
	local -n  ptr_arg_SourcStr_s8hd0=$1         ; shift || :  ## Arg <REQUIRED>: Nameref: Str: Source nameref with string to parse.
	local -r  delimStr="${1:- }"                ; shift || :  ## Arg [optional]: Str: The delimiter or substring to split on (default: space).
	local -ri fromRight=${1:-0}                 ; shift || :  ## Arg [optional]: Int: 0 if scan from left (default), 1 if from right (e.g. for first '.' filename extension).
	## Init
	ptr_output_LeftStr_s8hd0=""
	ptr_output_RightStr_s8hd0=""
	## Conditions where we know nothing will be returned.
	[[ -z "${ptr_arg_SourcStr_s8hd0}"  ]] && return 0
	if ((fromRight)); then
		## Conditions where we know that left will be empty, and right will == input.
		[[ -z "${delimStr}"                                ]]  &&  { ptr_output_RightStr_s8hd0="${ptr_arg_SourcStr_s8hd0}"; return 0; }  ## Delimiter is empty.
		[[     ${#delimStr} -ge ${#ptr_arg_SourcStr_s8hd0} ]]  &&  { ptr_output_RightStr_s8hd0="${ptr_arg_SourcStr_s8hd0}"; return 0; }  ## Delimiter is longer than source.
		[[ "${ptr_arg_SourcStr_s8hd0}" != *"${delimStr}"*  ]]  &&  { ptr_output_RightStr_s8hd0="${ptr_arg_SourcStr_s8hd0}"; return 0; }  ## Delimiter not in source [technically a superset of previous test].
		## Split on LAST match
		ptr_output_LeftStr_s8hd0="${ptr_arg_SourcStr_s8hd0%"${delimStr}"*}"
		ptr_output_RightStr_s8hd0="${ptr_arg_SourcStr_s8hd0##*"${delimStr}"}"
	else
		## Conditions where we know that right will be empty, and one left == input.
		[[ -z "${delimStr}"                                ]]  &&  { ptr_output_LeftStr_s8hd0="${ptr_arg_SourcStr_s8hd0}"; return 0; }  ## Delimiter is empty.
		[[     ${#delimStr} -ge ${#ptr_arg_SourcStr_s8hd0} ]]  &&  { ptr_output_LeftStr_s8hd0="${ptr_arg_SourcStr_s8hd0}"; return 0; }  ## Delimiter is longer than source.
		[[ "${ptr_arg_SourcStr_s8hd0}" != *"${delimStr}"*  ]]  &&  { ptr_output_LeftStr_s8hd0="${ptr_arg_SourcStr_s8hd0}"; return 0; }  ## Delimiter not in source [technically a superset of previous test].
		## Split on FIRST match
		ptr_output_LeftStr_s8hd0="${ptr_arg_SourcStr_s8hd0%%"${delimStr}"*}"
		ptr_output_RightStr_s8hd0="${ptr_arg_SourcStr_s8hd0#*"${delimStr}"}"
	fi
:;}

##	Quoted params
##		Purpose: Build a string from input parameters, with thing that need quoting, quoted, and thing that don't, not.
##		Example: fBuildQuotedParams myReturnVar Now_is "the time" for    '{12}'   'it\'s'  "thing > 1" goto 10."
##			"${myReturnVar}" == 'Now_is "the time" for "{12}" "it's" "thing > 1" goto 10."'
if [[ ! -v BUILD_QUOTED_PARAMS_CHECK_PATTERN ]]; then
	## Global constants
	declare -gr  BUILD_QUOTED_PARAMS_CHECK_PATTERN=$'[][[:space:]|&;()<>`*?$!~{}\'\"#=,%@\\]'  ## If an arg has any of these in it, it needs quoting.
	declare -gri BUILD_QUOTED_PARAMS_MAX_BLANK=10
fi
fBuildQuotedParams(){
	## Validate nameref args
	fIsNameref "${1:-}" || return ${ERRNUM_MSG_ALREADY_SHOWN}
	## Gather args
	local -n ptr_Output_1mtkp9p=1  # ; shift || :  ## The caller variable to instert the return value into.
	## Init
	ptr_Output_1mtkp9p=""
	local retVal=""
	## Determine highest used index
	local -i maxIdx=0 blankRun=0 i=0
	for ((i=1; ; i++)); do
		if [[ -n "${!i}" ]]; then maxIdx=$i; blankRun=0
		else                      (( ++blankRun >= BUILD_QUOTED_PARAMS_MAX_BLANK )) && break
		fi
	done
	## Build string, quote any args as necessary
	for i in $(seq 1 $maxIdx); do
		((i > 1)) && retVal+=" "  ## Pad with space if necessary
		if [[ "${!i}" =~ ${BUILD_QUOTED_PARAMS_CHECK_PATTERN} ]]; then retVal+="\"${!i}\""
		else                                                           retVal+="${!i}"
		fi
	done
	## Return the string
	ptr_Output_1mtkp9p="${retVal}"
}


